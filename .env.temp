# ============================================================
# Environment Variables Template
# Copy values from your Vercel Dashboard / provider dashboards
# ============================================================

# -- Google Maps (NEXT_PUBLIC_ = visible in browser, restrict by HTTP referrer in Google Cloud Console)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# -- Gemini AI (server-side only, never exposed to browser)
GEMINI_API_KEY=your_gemini_api_key_here

# -- Neon PostgreSQL (from Vercel Dashboard → Storage → Neon)
# Pooled connection string (use for normal queries)
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require

# -- Upstash Redis (from Vercel Dashboard → Storage → Upstash)
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here
